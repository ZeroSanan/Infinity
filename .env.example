# Binance API Credentials
# Copy this file to .env and fill in your keys
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# Set to "true" to use Binance Testnet instead of live trading
USE_TESTNET=false

# Anthropic API Key (for the Claude chat assistant in the dashboard)
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Dashboard port (default 5050)
DASHBOARD_PORT=5050

# Telegram alerts for LONG NOW / SHORT NOW signals (optional)
# 1. Create a bot via @BotFather and copy its token
# 2. Message the bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your numeric chat id
# 3. TELEGRAM_CHAT_ID accepts a comma-separated list to notify multiple chats,
#    e.g. TELEGRAM_CHAT_ID=111111111,222222222
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twelve Data API key — powers Market Signals for non-crypto assets
# (Gold/XAU, NVDA). Free tier: https://twelvedata.com/pricing
# Without this set, those cards show "Unknown" and the Binance-sourced
# coins are unaffected.
# Also powers the Layer 1 — Macro Environment DXY and VIX cards on the
# Market Signals tab; without it those cards fall back to manual links.
TWELVE_DATA_API_KEY=

# FRED (Federal Reserve Economic Data) API key — powers the Layer 1 —
# Macro Environment Fed Funds Rate, 10-Year Treasury Yield, and CPI cards
# on the Market Signals tab. Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Without this set, those cards fall back to manual links.
FRED_API_KEY=your_free_fred_key_here
